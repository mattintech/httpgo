# Copy to .env and adjust. Every setting is optional except where noted.

# --- Admin authentication: password (default) | oidc | none -----------------
# By default you create the admin account on first visit to /admin.
# AUTH_MODE=password

# Optional: manage the admin account here instead of the setup page.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=   # see README: generate with werkzeug's generate_password_hash

# AUTH_MODE=oidc (Google, Microsoft Entra, Okta, Authentik, Keycloak, ...)
# OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Google
# ADMIN_EMAILS=you@example.com,teammate@example.com
# ADMIN_EMAIL_DOMAINS=example.com

# Extra token for scripts calling /admin/api/* (or generate one in Settings)
# ADMIN_API_TOKEN=

# --- Deployment --------------------------------------------------------------
# PORT=8080
# SITE_NAME=go
# TRUSTED_PROXIES=1          # set when behind a reverse proxy (Traefik, nginx, Caddy)
# SESSION_COOKIE_SECURE=true # set when served over HTTPS
# SECRET_KEY=                # auto-generated and stored in /data if unset
